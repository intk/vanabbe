/********   Site Variables   ********/

/*-------------------
       Fonts
--------------------*/

@fontName: 'Roboto';
@fontSmoothing: antialiased;

@googleFontName: @fontName;
@importGoogleFonts: true;
@googleFontSizes: '300,400,500,700,400italic,700italic&display=swap';
@googleSubset: 'latin';

@googleProtocol: 'https://';
@googleFontRequest: '@{googleFontName}:@{googleFontSizes}&subset=@{googleSubset}';

/* Theme fonts  */
@mediumFont: 'Neue Haas Grotesk Medium';
@regularFont: 'Neue Haas Grotesk Regular';
@italicFont: 'Neue Haas Grotesk Italic';

@headerFont: @mediumFont, Arial, 'Helvetica Neue', Helvetica, sans-serif;
@pageFont: @mediumFont, Arial, 'Helvetica Neue', Helvetica, sans-serif;

@normal: normal;

/*-------------------
      Base Sizes
--------------------*/

/* This is the single variable that controls them all */
@emSize: 18px;

/* The size of page text  */
@fontSize: @emSize;

@sidebarWidth: 375px;
@collapsedSidebarWidth: 20px;
@mobileSidebarHeight: 100px;

/*--------------
  Page Heading
---------------*/

@desktopH1: unit((80 / @emSize), rem);
@desktopH2: unit((52 / @emSize), rem);
@desktopH3: unit((28 / @emSize), rem);
@desktopH4: unit((22 / @emSize), rem);
@desktopH5: unit((18 / @emSize), rem);

@tabletH1: unit((60 / @emSize), rem);
@tabletH2: unit((36 / @emSize), rem);
@tabletH3: unit((26 / @emSize), rem);
@tabletH4: unit((20 / @emSize), rem);
@tabletH5: unit((16 / @emSize), rem);

@mobileH1: unit((40 / @emSize), rem);
@mobileH2: unit((32 / @emSize), rem);
@mobileH3: unit((26 / @emSize), rem);
@mobileH4: unit((20 / @emSize), rem);
@mobileH5: unit((16 / @emSize), rem);

/*-------------------
    Brand Colors
--------------------*/

@primaryColor: @blue;
@secondaryColor: @darkGrey;

/*-------------------
      Site Colors
--------------------*/

@pearl: #f2eef8;
@wood: #655353;

@darkGrey: #1a1313;

/*---  Colors  ---*/
@orange: #ff9933;
@yellow: #f2eb49;
@olive: #78ab66;
@green: #51aa55;
@teal: #00928f;
@blue: #007eb1;
@violet: #6667ab;
@purple: #a530b8;
@pink: #f255d0;
@red: #b83230;
@brown: #ab8766;
@grey: #808285;
@black: #000000;

/*---  Light Colors  ---*/
@lightOlive: #c9eab1;
@lightGrey: #878f93;

/*---   Neutrals  ---*/
@fullBlack: #000000;
@offWhite: #f9fafb;
@darkWhite: #f3f4f5;
@midWhite: #dcddde;
@white: #ffffff;
@darkGrey: #444;

/*--- Colored Backgrounds ---*/
@redBackground: #f5c1c1;
@tealBackground: #edf1f2;
@blueBackground: #f2f6f8;
@purpleBackground: #b8c6c8;

/*-------------------
        Page
--------------------*/
@pageBackground: @white;
@desktopPadding: 40px;
@mobilePadding: 16px;

/*-------------------
      Typography
--------------------*/

@textColor: @darkGrey;

@extraFontSize: unit((28 / @emSize), rem);
@largeFontSize: unit((22 / @emSize), rem);
@bigFontSize: unit((18 / @emSize), rem);
@mediumFontSize: unit((16 / @emSize), rem);
@smallFontSize: unit((14 / @emSize), rem);

@largeMobileFontSize: unit((24 / @emSize), rem);
@mediumMobileFontSize: unit((20 / @emSize), rem);

@desktopLargeBodyFontSize: @largeFontSize;
@desktopBodyFontSize: @bigFontSize;
@tabletBodyFontSize: @mediumFontSize;
@mobileBodyFontSize: @smallFontSize;

/*---   Line height  ---*/
@smallLineHeight: 1.1;
@mediumLineHeight: 1.2;
@bigLineHeight: 1.3;
@largeLineHeight: 2.6;

/*-------------------
    Border Radius
--------------------*/

@defaultBorderRadius: 10px;

/*-------------------
        Grid
--------------------*/

@columnCount: 12;

/*-------------------
     Breakpoints
--------------------*/

@mobileBreakpoint: 320px;
@mobileLandscapeBreakpoint: 480px;
@tabletBreakpoint: 768px;
@contentBreakpoint: 835px;
@computerBreakpoint: 992px;
@smallMonitorBreakpoint: 1024px;
@largeMonitorBreakpoint: 1200px;
@widescreenMonitorBreakpoint: 1800px;

@contentMaxWidth: 1280px;

/*-------------------
      Other
--------------------*/

/*---  Shadows  ---*/
@globalShadow: 0 0 8px rgba(0, 0, 0, 0.08);

/* left/right column design for normal pages. */
@leftColumnSize: 30%;
@rightColumnSize: 70%;

.dynamicContentWidth(@toolbar, @sidebar) {
  left: @toolbar;
  width: calc(100% - @sidebar) !important;
}

@toReset: background-color, margin, padding, color, border, border-radius;

.resetStyle() {
  each(@toReset, {
    @{value}: unset;
  });
}

.isBtn() {
  &:extend(.ui.button);
  &:extend(.ui.primary.button);
  &:hover:extend(.ui.primary.button:hover) {
  }
  .resetStyle();
  font-weight: normal;
  border-radius: 0 !important;
}

.primaryBtn(@color) {
  padding: calc(0.9em - 2px) calc(1.1em - 2px);
  border: 2px solid @color;
  background-color: transparent;
  color: @color;
  font-weight: normal;

  &:hover,
  &:active,
  &:focus {
    padding: calc(0.9em - 4px) calc(1.1em - 4px);
    border: 4px solid @color;
    background-color: transparent;
    color: @color;
    text-decoration: none;
  }
}

.tertiaryBtn(@color, @bgcolor) {
  padding: 0.8em 1.4em;
  background-color: @color;
  color: @bgcolor;
  font-weight: normal;
  font-size: @mediumFontSize;
}

.secondaryBtn(@color) {
  padding: 0.65em 1em;
  border: 2px solid @color;
  background-color: transparent;
  color: @color;
  border-radius: 0;
  font-weight: normal;
  display: inline-block;

  &:hover {
    background-color: @color;
    text-decoration: none;
    color: @white;
    border: 2px solid @color;
  }
}

.darkOverlay() {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.slideOverlay(@direction) {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: linear-gradient(
    to @direction,
    rgba(0, 0, 0, 0.2),
    rgba(0, 0, 0, 0.6)
  );
}

.backgroundImage() {
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
}

// utilities
.horizontalAlign() {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.verticalAlign() {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.elipsisOverflow(@lines) {
  overflow: hidden;
  -webkit-line-clamp: @lines;
  display: -webkit-box;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
}

// Color themes for cards
.colorThemeSunny() {
  background-color: #dfff83;

  a {
    color: #231c1c;
  }
}

.colorThemeMint() {
  background-color: #cce7d2;

  a {
    color: #9a1313;
  }
}

.colorThemeGray() {
  background-color: #f2eef8;

  a {
    color: #655353;
  }
}

.colorThemeOrange() {
  background-color: #ffde8a;

  a {
    color: #6e2b4d;
  }
}

.colorThemePeach() {
  background-color: #ffceaa;

  a {
    color: #2d1d1d;
  }
}

.colorThemeYellow() {
  background-color: #f5ff83;

  a {
    color: #9a1313;
  }
}
