/********   Site Variables   ********/

/*-------------------
       Fonts
--------------------*/

@fontName: 'Nunito';
@headerFontName: 'Playfair+Display';

@headerFont: 'Playfair Display', sans-serif;
@pageFont: 'Nunito', sans-serif;

@importGoogleFonts: true;
@googleFontName: @fontName;
@googleFontSizes: '300,400,500,600,700,400italic,700italic,800';
@googleSubset: 'latin';

@googleProtocol: 'https://';
@googleFontRequest: '@{googleFontName}:@{googleFontSizes}|@{headerFontName}:@{googleFontSizes}';

@bold: bold;
@normal: normal;

@boldFont: @headerFont;
@mediumFont: @fontName;
@lightFont: @pageFont;

@font-weight-1: 100;
@font-weight-2: 200;
@font-weight-3: 300;
@font-weight-4: 400;
@font-weight-5: 500;
@font-weight-6: 600;
@font-weight-7: 700;
@font-weight-8: 800;
@font-weight-9: 900;

/*-------------------
      Base Sizes
--------------------*/

/* This is the single variable that controls them all */
@emSize: 16px;

/* The size of page text  */
@fontSize: 1rem;

@sidebarWidth: 375px;
@collapsedWidth: 20px;

/*--------------
  Page Heading
---------------*/

@headerFontWeight: @font-weight-5;

@h1: 2.8rem;
@h2: 1.438rem;
@h3: 1.25rem;
@h4: 1.125rem;
@h5: 1rem;
@h6: 0.875rem;

/*-------------------
    Brand Colors
--------------------*/

@primaryColor: @yellow;
@secondaryColor: @brown;
@tertiaryColor: @darkGreen;

/*-------------------
      Site Colors
--------------------*/
@black: #000000;
@darkgrey: #4e4d4b;
@darkerGrey: #282424;
@lightergrey: #f1f1f1;
@pink: #ef12a6;
@blueLight: #28b9f7;
@greenLight: #97cc0a;
@grey: #636886;
@yellow: #d59b2d;
@blue: #27304b;
@brown: #5a3a31;
@darkGreen: #477763;
@lightGreen: #01865f;
@darkBlue: #1a233d;
@lightBrown: #716d6c;

@cycleColors: @pink, @yellow, @blueLight, @greenLight;

/*-------------------
        Page
--------------------*/

@pageBackground: #f8f4f3;
@textColor: @grey;
@lineHeight: 1.9;

/*-------------------
    Border Radius
--------------------*/

@defaultBorderRadius: 10px;

/*-------------------
      Other
--------------------*/

/*---  Shadows  ---*/
@globalShadow: 0 0 8px rgba(0, 0, 0, 0.08);

/* left/right column design for normal pages. */
@leftColumnSize: 30%;
@rightColumnSize: 70%;

.stickyHeaderWidth(@toolbar, @sidebar) {
  left: @toolbar;
  width: calc(100% - @sidebar);
}

.animate(@property) {
  transition: @property 0.4s ease-in-out;
}

.animateCssTransition(@className) {
  .@{className}-enter {
    opacity: 0;
  }
  .@{className}-enter-active {
    opacity: 1;
    transition: opacity 200ms;
  }
  .@{className}-exit {
    opacity: 1;
  }
  .@{className}-exit-active {
    opacity: 0;
    transition: opacity 200ms;
  }
}

.cycleBackground() {
  @len: length(@cycleColors);

  // repeat the colors for every nth child
  each(@cycleColors,  {
    &:nth-child(@{len}n+@{index}) {
      background-image: linear-gradient(90deg, @value 50%, @white 50%) ;
    }
  });
}

.innerCycleBorder(@margin, @side) {
  @len: length(@cycleColors);

  // repeat the colors for every nth child
  each(@cycleColors,  {
    &:nth-child(@{len}n+@{index}):@{side} {
      border-@{margin}-color: @value !important;
    }
  });
}

.cycleBorder(@margin) {
  & when (@margin = top) {
    .innerCycleBorder(@margin, before);
  }

  & when (@margin = bottom) {
    .innerCycleBorder(@margin, after);
  }
}

.cycleBorderNoside(@margin) {
  @len: length(@cycleColors);

  // repeat the colors for every nth child
  each(@cycleColors,  {
    &:nth-child(@{len}n+@{index}) {
      border-@{margin}-color: @value !important;
    }
  });
}

.innerBorderAnimate(@startColor, @endColor, @size, @margin, @side) {
  border-@{margin}: @size @startColor solid;

  &:@{side} {
    display: block;
    border-@{margin}: solid @size @endColor;
    margin-@{margin}: -@size;
    content: '';
    transform: scaleX(0);
    transform-origin: 0% 50%;
    transition: transform 250ms ease-in-out;
  }

  &:hover:@{side} {
    transform: scaleX(1);
    transform-origin: 0% 50%;
  }
}

.animateBorder(@startColor, @endColor, @size, @margin) {
  @side: after;

  & when (@margin = bottom) {
    @side: after;

    .innerBorderAnimate(@startColor, @endColor, @size, @margin, @side);
  }

  & when (@margin = top) {
    @side: before;
    .innerBorderAnimate(@startColor, @endColor, @size, @margin, @side);
  }
}

.animateBackgroundImage() {
  // needs an element like:
  //
  // div.listing-card (.animateBackgroundImage())
  //  div.image-container
  //    a
  //      img

  .image-container {
    overflow: hidden;
    position: relative;
    height: 100%;
    z-index: 0;
    max-height: 50%;
  }

  img {
    // See https://w3bits.com/css-image-hover-zoom/
    transition: transform 0.2s ease;
  }

  &:hover img {
    transform: scale(1.1);
  }
}

@toReset: background-color, margin, padding, color, border, border-radius;

.resetStyle() {
  each(@toReset, {
    @{value}: unset;
  });
}

.greenLined() {
  .animateBorder(@greenLight, @white, 4px, bottom);
}

.blueLined() {
  // border-bottom: 4px @blueLight solid;

  .animateBorder(@blueLight, @white, 4px, bottom);
}

.circularIcon(@color) {
  width: 52px !important;
  height: 52px !important;
  padding: 0.8em 0em !important;
  box-shadow: 0em 0em 0em 0.1em @color inset;
  font-size: 1.3rem;
  color: @color;

  &:hover {
    box-shadow: 0em 0em 0em 0.1em @primaryColor inset;
    color: @primaryColor;
  }
}

.outlinedBtn(@color, @hoverColor) {
  .isBtn();

  color: @color;
  background-color: transparent;
  border: 2px solid @color;

  &:hover {
    color: @hoverColor;
    border: 2px solid @hoverColor;
  }
}

.isBtn() {
  &:extend(.ui.button);
  &:extend(.ui.primary.button);
  &:hover:extend(.ui.primary.button:hover) {
  }

  padding: 0.719rem 1.9rem;
  border-radius: 60px;
  display: inline-flex;
  justify-content: center;
  font-family: @headerFont;
  font-size: 1rem;
  line-height: 1.5;
  cursor: pointer;
  min-height: 1em;
  text-shadow: none;
  font-weight: 800;
  text-align: center;
  border: 1px solid transparent;
  box-shadow: none;
}

