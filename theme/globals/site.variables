.fullWidthOnMobile() {
  @media only screen and (max-width: @largestMobileScreen) {
    width: 100%;
  }
}

.bigHeading(@color) {
  color: @color;
  font-size: 2.8rem;
  position: relative;
  font-weight: 800;
  margin-bottom: 3rem;
  font-family: @headerFont;

  @media only screen and (max-width: @largestMobileScreen) {
    font-size: 1.95rem;
  }
}

.smallHeading(@color) {
  color: @color;
  font-family: @headerFont;
  position: relative;
  text-transform: capitalize;
  margin-bottom: 15px;
  display: block;
  font-size: 1.2rem;
  font-weight: 600;

  @media (max-width: @largestMobileScreen) {
    padding-left: 60px;
  }

  &:after {
    position: absolute;
    content: '';
    height: 2px;
    width: 41px;
    background: @color;
    top: 50%;
    left: -60px;
    transform: translateY(-50%);

    @media (max-width: @largestMobileScreen) {
      left: 0;
    }
  }
}

.fontSizeSecondary() {
  font-size: clamp(0.875rem, 2.25vw, 1.125rem);
  line-height: clamp(1.026rem, 2.25vw, 1.318rem);
}

.h1Text() {
  font-size: clamp(2rem, 4.25vw, 4.06rem);
  line-height: clamp(2.4rem, 4.25vw, 4.875rem);
}

.h2Text() {
  font-size: clamp(1.75rem, 3.75vw, 4.063rem);
  line-height: clamp(2.1rem, 3.75vw, 4.063rem);
}

.h3Text() {
  font-size: clamp(1.75rem, 3.25vw, 2.813rem);
  line-height: clamp(2.1rem, 3.25vw, 2.813rem);
}

.h4Text() {
  font-size: clamp(1.125rem, 2.75vw, 1.75rem);
  line-height: clamp(1.35rem, 2.75vw, 2.1rem);
}

.h5Text() {
  font-size: clamp(1rem, 2vw, 1.25rem);
  // line-height: clamp(1.35rem, 2.75vw, 2.1rem);
}

.pText() {
  font-size: clamp(1rem, 2.25vw, 1.375rem);
  letter-spacing: 0.02em;
  line-height: clamp(1.3rem, 2.25vw, 1.788rem);
}

.darkOverlay() {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.slideOverlay(@direction) {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: linear-gradient(
    to @direction,
    rgba(0, 0, 0, 0.2),
    rgba(0, 0, 0, 0.6)
  );
}

// utilities
.horizontalAlign() {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.verticalAlign() {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.elipsisOverflow(@lines) {
  overflow: hidden;
  -webkit-line-clamp: @lines;
  display: -webkit-box;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
}
