/********   Site Variables   ********/

/*-------------------
       Fonts
--------------------*/

@fontName: 'Roboto';
@fontSmoothing: antialiased;

@googleFontName: @fontName;
@importGoogleFonts: true;
@googleFontSizes: '300,400,500,700,400italic,700italic&display=swap';
@googleSubset: 'latin';

@googleProtocol: 'https://';
@googleFontRequest: '@{googleFontName}:@{googleFontSizes}&subset=@{googleSubset}';

/* Theme fonts  */
@mediumFont: 'Neue Haas Grotesk Medium';
@regularFont: 'Neue Haas Grotesk Regular';
@italicFont: 'Neue Haas Grotesk Italic';

@headerFont: @mediumFont, Arial, 'Helvetica Neue', Helvetica, sans-serif;
@pageFont: @mediumFont, Arial, 'Helvetica Neue', Helvetica, sans-serif;

@normal: normal;

/*-------------------
      Base Sizes
--------------------*/

/* This is the single variable that controls them all */
@emSize: 16px;

/* The size of page text  */
@fontSize: 20px;

@sidebarWidth: 375px;
@collapsedSidebarWidth: 20px;
@mobileSidebarHeight: 100px;

/*--------------
  Page Heading
---------------*/

@h1: unit((80 / @fontSize), rem);
@h2: unit((44 / @fontSize), rem);
@h3: unit((40 / @fontSize), rem);
@h4: unit((36 / @fontSize), rem);
@h5: unit((28 / @fontSize), rem);
@h6: unit((16 / @fontSize), rem);

/*-------------------
    Brand Colors
--------------------*/

@primaryColor: @blue;
@secondaryColor: @darkGrey;

/*-------------------
      Site Colors
--------------------*/

@smokeWhite: #f2eef8;
@wood: #655353;

@darkGrey: #1a1313;

/*---  Colors  ---*/
@orange: #ff9933;
@yellow: #f2eb49;
@olive: #78ab66;
@green: #51aa55;
@teal: #00928f;
@blue: #007eb1;
@violet: #6667ab;
@purple: #a530b8;
@pink: #f255d0;
@red: #b83230;
@brown: #ab8766;
@grey: #808285;
@black: #000000;

/*---  Light Colors  ---*/
@lightOlive: #c9eab1;
@lightGrey: #878f93;

/*---   Neutrals  ---*/
@fullBlack: #000000;
@offWhite: #f9fafb;
@darkWhite: #f3f4f5;
@midWhite: #dcddde;
@white: #ffffff;
@darkGrey: #444;

/*--- Colored Backgrounds ---*/
@redBackground: #f5c1c1;
@tealBackground: #edf1f2;
@blueBackground: #f2f6f8;
@purpleBackground: #b8c6c8;

/*-------------------
        Page
--------------------*/

@pageBackground: @white;
@textColor: @darkGrey;
@lineHeight: 1.9;

/*-------------------
    Border Radius
--------------------*/

@defaultBorderRadius: 10px;

/*-------------------
     Breakpoints
--------------------*/

@mobileBreakpoint: 320px;
@mobileLandscapeBreakpoint: 480px;
@tabletBreakpoint: 768px;
@contentBreakpoint: 835px;
@computerBreakpoint: 992px;
@smallMonitorBreakpoint: 1024px;
@largeMonitorBreakpoint: 1200px;
@siteBreakpoint: 1400px;

/*-------------------
      Other
--------------------*/

/*---  Shadows  ---*/
@globalShadow: 0 0 8px rgba(0, 0, 0, 0.08);

/* left/right column design for normal pages. */
@leftColumnSize: 30%;
@rightColumnSize: 70%;

.stickyHeaderWidth(@toolbar, @sidebar) {
  left: @toolbar;
  width: calc(100% - @sidebar);
}

@toReset: background-color, margin, padding, color, border, border-radius;

.resetStyle() {
  each(@toReset, {
    @{value}: unset;
  });
}

.isBtn() {
  &:extend(.ui.button);
  &:extend(.ui.primary.button);
  &:hover:extend(.ui.primary.button:hover) {
  }
}

.darkOverlay() {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.slideOverlay(@direction) {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: linear-gradient(
    to @direction,
    rgba(0, 0, 0, 0.2),
    rgba(0, 0, 0, 0.6)
  );
}

// utilities
.horizontalAlign() {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.verticalAlign() {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.elipsisOverflow(@lines) {
  overflow: hidden;
  -webkit-line-clamp: @lines;
  display: -webkit-box;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
}
