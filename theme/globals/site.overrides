/********   Site Overrides   ********/

// .debug(@googleFontRequest);

.loadVanabbeFonts();

html {
  font-size: @fontSize;

  @media only screen and (max-width: @largestSmallMonitor) {
    font-size: 18px;
  }
}

body {
  position: relative;
  background: @pageBackground;
  color: @textColor;
  font-family: @pageFont;
  font-size: @fontSize;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  font-weight: unset !important;
}

h1 {
  font-size: @h1;
}

h2 {
  font-size: @h2;
}

h3 {
  font-size: @h3;
}

h4 {
  font-size: @h4;
}

h5 {
  font-size: @h5;
}

p {
  font-size: @fontSize;
}

.documentDescription {
  color: inherit !important;
}

#page-edit .ui.form,
#page-controlpanel .ui.form {
  background-color: @white;
}

#page-contents {
  #content-core {
    background-color: @white;
  }
}

.content-area {
  main,
  #view {
    height: 100%;
  }
}
