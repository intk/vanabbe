/********   Site Overrides   ********/

// .debug(@googleFontRequest);

.loadUtrechtFonts();

html {
  font-size: @fontSize;

  @media only screen and (max-width: @largestSmallMonitor) {
    font-size: 15px;
  }
}

body {
  position: relative;
  background: @pageBackground;
  color: @textColor;
  font-family: @pageFont;
  font-size: 1rem;
  font-weight: @font-weight-4;
}

h1 {
  color: @primaryColor;
  font-size: @h1;
  font-weight: @font-weight-8;
}

h2 {
  color: @primaryColor;
  font-size: @h2;
  font-weight: @headerFontWeight;
}

h3 {
  color: @blue;
  font-size: @h3;
  font-weight: @headerFontWeight;
}

h4 {
  font-size: @h4;
  font-weight: @headerFontWeight;
}

h5 {
  font-size: @h5;
  font-weight: @headerFontWeight;
}

p {
  font-size: @fontSize;
}
