/********   Site Overrides   ********/

// .debug(@googleFontRequest);

.loadVanabbeFonts();

#page-add,
#page-edit,
#page-controlpanel {
  .ui.form {
    background-color: @white;
  }
}

#page-contents {
  #content-core {
    background-color: @white;
  }
}

.content-area {
  background-color: var(--background-color) !important;

  main,
  #view {
    height: 100%;
  }
}
