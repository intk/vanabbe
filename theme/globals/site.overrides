/********   Site Overrides   ********/

// .debug(@googleFontRequest);

.loadVanabbeFonts();

html {
  font-size: @fontSize;

  @media only screen and (max-width: @largestSmallMonitor) {
    font-size: 18px;
  }
}

body {
  position: relative;
  background: @pageBackground;
  color: @textColor;
  font-family: @pageFont;
  font-size: @fontSize;
  line-height: @bigLineHeight;
}

#page-add,
#page-edit,
#page-controlpanel{
  .ui.form {
    background-color: @white;
  }
}

.view-addview,
.view-editview,
.section-controlpanel {
  .sticky-heading {
    display: none !important; 
  }
}

#page-contents {
  #content-core {
    background-color: @white;
  }
}

.content-area {
  main,
  #view {
    height: 100%;
  }
}
