/********   Site Overrides   ********/

// .debug(@googleFontRequest);

.loadVanabbeFonts();

html {
  font-size: @fontSize;

  @media only screen and (max-width: @largestSmallMonitor) {
    font-size: 18px;
  }
}

body {
  position: relative;
  background: @pageBackground;
  color: @textColor;
  font-family: @pageFont;
  font-size: @fontSize;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  font-weight: unset !important;
}

h1 {
  color: @primaryColor;
  font-size: @h1;
}

h2 {
  color: @primaryColor;
  font-size: @h2;
}

h3 {
  color: @blue;
  font-size: @h3;
}

h4 {
  font-size: @h4;
}

h5 {
  font-size: @h5;
}

p {
  font-size: @fontSize;
}
