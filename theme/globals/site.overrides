/********   Site Overrides   ********/

// .debug(@googleFontRequest);

.loadVanabbeFonts();

html {
  font-size: @fontSize;

  @media only screen and (max-width: @largestSmallMonitor) {
    font-size: 18px;
  }
}

body {
  position: relative;
  background: @pageBackground;
  color: @textColor;
  font-family: @pageFont;
  font-size: @fontSize;
  line-height: @bigLineHeight;
}

#page-edit .ui.form,
#page-controlpanel .ui.form {
  background-color: @white;
}

.view-addview,
.view-editview {
  .sticky-heading {
    display: none !important; 
  }
}

#page-contents {
  #content-core {
    background-color: @white;
  }
}

.content-area {
  main,
  #view {
    height: 100%;
  }
}
