/*******************************
        Theme Selection
*******************************/

/* To override a theme for an individual element specify theme name below */

/* Global */
@site        : 'pastanaga';
@reset       : 'pastanaga';

/* Elements */
@button      : 'pastanaga';
@container   : 'pastanaga';
@divider     : 'pastanaga';
@flag        : 'pastanaga';
@header      : 'pastanaga';
@icon        : 'default';
@image       : 'pastanaga';
@input       : 'pastanaga';
@label       : 'pastanaga';
@list        : 'pastanaga';
@loader      : 'pastanaga';
@placeholder : 'pastanaga';
@rail        : 'pastanaga';
@reveal      : 'pastanaga';
@segment     : 'pastanaga';
@step        : 'pastanaga';

/* Collections */
@breadcrumb  : 'pastanaga';
@form        : 'pastanaga';
@grid        : 'pastanaga';
@menu        : 'pastanaga';
@message     : 'pastanaga';
@table       : 'pastanaga';

/* Modules */
@accordion   : 'pastanaga';
@checkbox    : 'pastanaga';
@dimmer      : 'pastanaga';
@dropdown    : 'pastanaga';
@embed       : 'pastanaga';
@modal       : 'pastanaga';
@nag         : 'pastanaga';
@popup       : 'pastanaga';
@progress    : 'pastanaga';
@rating      : 'pastanaga';
@search      : 'pastanaga';
@shape       : 'pastanaga';
@sidebar     : 'pastanaga';
@sticky      : 'pastanaga';
@tab         : 'pastanaga';
@transition  : 'pastanaga';

/* Views */
@ad          : 'pastanaga';
@card        : 'pastanaga';
@comment     : 'pastanaga';
@feed        : 'pastanaga';
@item        : 'pastanaga';
@statistic   : 'pastanaga';

/* Extras */
@main        : 'pastanaga';
@custom      : 'pastanaga';

@hero: 'utrecht';

/*******************************
            Folders
*******************************/

/* Path to theme packages */
@themesFolder : './../node_modules/@plone/volto/theme/themes';

/* Path to site override folder */
@siteFolder  : "./theme";
@fontsFolder : "./assets/fonts";

@assetsFolder: "./../../../../../../../theme/assets";

/*******************************
         Import Theme
*******************************/

@import (multiple) "./theme.less";

@fontPath : "../../@{theme}/assets/fonts";

.loadThemeFont(@familyName, @fontName) {
  @font-face {
    font-family: @familyName;
    src: url('@{fontsFolder}/@{fontName}.woff') format('woff'),
      url('@{fontsFolder}/@{fontName}.woff2') format('woff2');
  }
}

.loadVanabbeFonts() {
  .loadThemeFont ('Neue Haas Grotesk Medium', 'Neue Haas Grotesk Medium');;
  .loadThemeFont ('Neue Haas Grotesk Medium Italic', 'Neue Haas Grotesk Medium Italic');;
  .loadThemeFont ('Neue Haas Grotesk Italic', 'Neue Haas Grotesk Italic');;
  .loadThemeFont ('Neue Haas Grotesk Regular', 'Neue Haas Grotesk Regular');;
}


/* End Config */
