/*******************************
         Button Overrides
*******************************/

.ui.button,
.link-more a {
  .isBtn();
}

.link-more a,
.ui.primary.button:not(.basic):not(.icon):not(.circular) {
  padding: calc(0.9em - 2px) calc(1.1em - 2px);
  border: 2px solid var(--text-color);
  background-color: transparent;
  color: var(--text-color);
}

.link-more a:hover,
.ui.primary.button:not(.basic):not(.icon):not(.circular):hover,
.ui.primary.button:not(.basic):not(.icon):not(.circular):active,
.ui.primary.button:not(.basic):not(.icon):not(.circular):focus {
  padding: calc(0.9em - 4px) calc(1.1em - 4px);
  border: 4px solid var(--text-color);
  background-color: transparent;
  color: var(--text-color);
  text-decoration: none;
}

.ui.button.big-button {
  padding-bottom: 3px;
  border-bottom: 2px solid transparent;
  background-color: transparent;

  &:hover,
  &:active {
    border-color: var(--text-color);
    color: var(--text-color) !important;
  }
}

// .link-more a {
//   .isBtn();
// }

.ui.basic.buttons .button:hover,
.ui.basic.button:hover,
.ui.basic.button:active,
.ui.basic.button:focus {
  background-color: transparent !important;
}
