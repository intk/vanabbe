/*******************************
         Button Overrides
*******************************/

.ui.button,
.link-more a {
  .isBtn();

  &:hover {
    background-color: transparent;
    color: inherit;
  }
}

.link-more a,
.ui.primary.button:not(.basic):not(.icon):not(.circular) {
  .primaryBtn(var(--text-color));
}

.ui.button.secondary.load-more {
  display: flex !important;
  align-items: center;
  margin: 0 auto;
  margin-top: 4em;
  gap: 15px;
  text-transform: lowercase;

  svg {
    margin: 0 !important;
  }
}

.ui.secondary.button:not(.icon):not(.circular) {
  .secondaryBtn(var(--text-color));
}

.ui.button.tertiary {
  .tertiaryBtn(var(--text-color), var(--background-color));
}

.ui.button.nav-button {
  padding-bottom: 3px;
  border-bottom: 2px solid transparent;
  background-color: transparent;

  &:hover,
  &:active {
    border-color: var(--text-color);
    color: var(--text-color) !important;
  }
}

.ui.button:active:not(.primary):not(.secondary):not(.tertiary),
.ui.button:focus:not(.primary):not(.secondary):not(.tertiary),
.ui.basic.buttons .button:hover,
.ui.basic.button:hover,
.ui.basic.button:active,
.ui.basic.button:focus {
  background-color: transparent !important;
}
