/*******************************
         Container Overrides
*******************************/

/* All Sizes */
#main .ui.container,
.ui.container {
  display: block;
  width: 100% !important;
  max-width: @contentMaxWidth !important;
  padding-right: @desktopPadding !important;
  padding-left: @desktopPadding !important;

  > .ui.container {
    padding: 0 !important;
  }

  @media only screen and (max-width: @largestTabletScreen) {
    padding-right: @mobilePadding !important;
    padding-left: @mobilePadding !important;
    margin: 0 auto !important;
  }

  @media only screen and (max-width: @largestMobileScreen) {
    .offset-1-right {
      margin-right: 46px;
    }
  }
}

#main {
  #page-document.ui.container,
  .hero-container.ui.container {
    padding-right: 0 !important;
  }
}
