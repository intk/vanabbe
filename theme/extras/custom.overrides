/*******************************
         Custom Overrides
*******************************/

@import './animations.less';
@import './document.less';
@import './listing.less';
@import './footer.less';
@import './search.less';
@import './blocks.less';
@import './event.less';
@import './header.less';
@import './themes.less';
@import './menu.less';
@import './artwork.less';

// .view-viewview.has-image {
//   #main > .breadcrumbs {
//     display: none !important;
//   }
// }

// White space in blocks chooser CMS
.blocks-chooser .ui.accordion .title ~ .content,
.blocks-chooser .ui.accordion .accordion .title ~ .content {
  display: contents !important;
}

// fix block chooser, broken by volto-block-style stretch styling
body:not(.view-editview):not(.document_wide_view):not(.is-anonymous) main {
  overflow: unset;
}

// Fix font family in toolbar
#toolbar .pastanaga-menu-list li a,
#toolbar .pastanaga-menu-list li button {
  font-family: @pageFont;
}

.ui.button.full-size-sidenav-btn {
  border: none;
}

body.view-editview,
body.view-addview,
.section-controlpanel,
.section-contents,
.section-login,
.section-passwordreset {
  .logo-wrapper {
    display: none;
  }
}


#main .view-wrapper.not-found {
  padding-right: @twoWide !important;
}

#toolbar .toolbar-content {
  z-index: 200;
}

.preview-image {
  object-fit: cover;
  object-position: center;
  transition: transform 0.5s ease;
}