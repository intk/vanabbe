// .view-viewview.has-image {
//   #main > .breadcrumbs {
//     display: none !important;
//   }
// }

// White space in blocks chooser CMS
.blocks-chooser .ui.accordion .title ~ .content,
.blocks-chooser .ui.accordion .accordion .title ~ .content {
  display: contents !important;
}

// fix block chooser, broken by volto-block-style stretch styling
body:not(.view-editview):not(.document_wide_view):not(.is-anonymous) main {
  overflow: unset;
}

// Fix font family in toolbar
#toolbar .pastanaga-menu-list li a,
#toolbar .pastanaga-menu-list li button {
  font-family: @pageFont;
}

.ui.button.full-size-sidenav-btn {
  border: none;
}

// Hide logo on edit view
body.view-editview {
  .logo-wrapper {
    display: none;
  }
}
