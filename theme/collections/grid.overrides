.offset-1-left {
  margin-left: @oneWide;
}

.offset-1-right {
  margin-right: @oneWide;
}

.offset-2-left {
  margin-left: @twoWide;
}

.offset-2-right {
  margin-right: @twoWide;
}

.offset-3-right {
  margin-right: @threeWide;
}
