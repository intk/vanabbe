/*******************************
         Grid Overrides
*******************************/

/*-------------------
       Columns
--------------------*/

/* Standard 12 column */
.ui.grid > .column:not(.row),
.ui.grid > .row > .column {
  position: relative;
  display: inline-block;

  width: @oneWide;
  padding-right: (@gutterWidth / 2);
  padding-left: (@gutterWidth / 2);
  vertical-align: top;
}

.ui.grid > * {
  padding-right: (@gutterWidth / 2);
  padding-left: (@gutterWidth / 2);
}

@media only screen and (max-width: @tabletBreakpoint) {
  .ui.grid > .column:not(.row),
  .ui.grid > .row > .column {
    padding-right: (@mobileGutterWidth / 2);
    padding-left: (@mobileGutterWidth / 2);
  }

  .ui.grid > * {
    padding-right: (@mobileGutterWidth / 2);
    padding-left: (@mobileGutterWidth / 2);
  }
}
