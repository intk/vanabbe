<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="intk_vanabbe"
    >

  <adapter
      factory=".contextlinks.ContextLinks"
      name="contextLinks"
      />

  <plone:service
      method="GET"
      factory=".contextlinks.ContextLinksGet"
      for="zope.interface.Interface"
      permission="zope2.View"
      name="@contextLinks"
      />

</configure>
